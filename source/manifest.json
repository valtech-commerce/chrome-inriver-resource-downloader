{
  "manifest_version": 3,

  "name": "inRiver Resource Downloader",
  "description": "This extension allows the user to download all resources from a workarea.",
  "version": "0.5",

  "background": {
    "service_worker": "event.js",
    "scripts": ["event.js"]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon128.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
	"scripting",
    "background",
    "downloads"
  ],
  "host_permissions": [
	"*://*.productmarketingcloud.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{96cc1f98-94d1-4eaa-9b6b-9cdfa4bcf8ba}",
      "strict_min_version": "109.0"
    }
  }
}
